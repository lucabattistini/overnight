# The installer window's geometry, in points, in one place.
#
# Two things have to agree about this layout and they are written in different languages:
# scripts/make-dmg.sh, which tells Finder where to put the window and the two icons, and
# scripts/icons.py, which paints the background those icons sit on. If they disagreed the
# arrow would point at empty space. So neither of them owns these numbers — both read this
# file, and `python3 scripts/icons.py verify` re-derives the background from it.
#
# Shell reads this with `.`; Python parses it as KEY=value. Keep it to unquoted integers and
# bare words, with no substitutions, so both readers stay trivial.

# The volume, and therefore the mount point the packaging script insists on.
DMG_VOLUME_NAME=Overnight

# The Finder window's content area, which is also the background image's size at 1x. The
# checked-in @2x asset is exactly twice this in each direction, which is what `tiffutil
# -cathidpicheck` requires before it will pair them into one HiDPI TIFF.
DMG_WINDOW_WIDTH=600
DMG_WINDOW_HEIGHT=400

# Where that window opens on the installing machine's screen. Top left corner.
DMG_WINDOW_X=360
DMG_WINDOW_Y=140

# Icon view options. 128pt is the largest size Finder offers that still leaves room for two
# icons, an arrow between them and a margin in a 600pt window.
DMG_ICON_SIZE=128
DMG_TEXT_SIZE=12

# Icon centres, in the window's own coordinates: x right, y down from the top left of the
# content area. Finder positions icons by their centre, and the label hangs below that.
DMG_APP_X=150
DMG_APP_Y=190
DMG_APPLICATIONS_X=450
DMG_APPLICATIONS_Y=190
